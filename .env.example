# Copy to .env. Local development defaults; do not commit real secrets.
IOT_DB_PASSWORD=iotpass
IOT_SENSOR_ALGORITHM=aes-256-gcm
# Generate once with: openssl rand -base64 32. Configure the same key on the sensor.
IOT_AES_KEY_BASE64=
# Docker Desktop example for a sensor on the host:
IOT_SENSOR_URL=http://host.docker.internal:9000
IOT_SENSOR_PATH=/api/v1/commands
# Optional; obtain from BotFather. Empty means notifications are disabled.
IOT_TELEGRAM_BOT_TOKEN=
IOT_SMTP_URL=smtp://mailpit:1025
IOT_SMTP_USER=
IOT_SMTP_PASSWORD=
IOT_SMTP_FROM=iot@example.com
